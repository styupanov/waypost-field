VALHALLA_URL=http://localhost:8002
# Standalone Next.js server settings. ECS can override PORT at runtime.
HOSTNAME=0.0.0.0
PORT=3000
DATABASE_URL=
# Explicit migration/ETL --target rds only; the Next.js app ignores these.
RDS_DATABASE_URL=
RDS_SSL_ROOT_CERT=
# Python --target rds-secret only; environment-only at runtime (no dotenv fallback).
RDS_SECRET_ID=
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
HERE_API_KEY=
# Server-side raw ingestion; disabled unless explicitly set to true.
RAW_PROVIDER_ARCHIVE_ENABLED=false
RAW_PROVIDER_ARCHIVE_BUCKET=geospatial-learning-sergei-2026
AWS_REGION=us-east-1
# Local SSO only; omit in deployed environments using IAM roles.
AWS_PROFILE=travel-dev
AUTH_SECRET=
# Required behind a trusted container ingress/reverse proxy such as the ECS ALB.
AUTH_TRUST_HOST=false
LOCAL_AUTH_ENABLED=false
LOCAL_AUTH_USER_A_EMAIL=
LOCAL_AUTH_USER_A_PASSWORD=
LOCAL_AUTH_USER_A_SUBJECT=local:serge
LOCAL_AUTH_USER_A_NAME=
LOCAL_AUTH_USER_B_EMAIL=
LOCAL_AUTH_USER_B_PASSWORD=
LOCAL_AUTH_USER_B_SUBJECT=local:test-user-b
LOCAL_AUTH_USER_B_NAME=
