# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tmp/h3-calibration/
/tmp/route-divergence/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
!/certs/global-bundle.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python ETL
__pycache__/
*.py[cod]
/etl/.venv/

.env.rds.local

# Terraform local state, downloaded providers and private reconciliation inputs
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
/infra/terraform/*.tfvars
!/infra/terraform/workflow.example.tfvars
/infra/terraform/*.auto.tfvars.json
/infra/terraform/terraform.tfvars.json
# Commit .terraform.lock.hcl after a reviewed terraform init.
